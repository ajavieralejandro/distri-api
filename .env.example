NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://distrisoft:distrisoft@localhost:5432/distrisoft

# Comma-separated origins, or * for all (development only)
CORS_ORIGIN=*

# Random string of at least 32 characters. Do not commit a real value.
JWT_SECRET=replace-with-a-random-string-of-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Password for the development seed users. Never commit a real value.
SEED_PASSWORD=replace-with-a-test-password
# npm run prisma:seed refuses NODE_ENV=production.
# For a non-local database it also requires SEED_CONFIRM=yes.
# SEED_CONFIRM=yes
#
# Separate command: npm run test-data:init
# It never runs on start or migrate. Existing accounts and passwords are left as they are.
# INIT_TEST_DATA=yes
# INIT_TEST_DATABASE_NAME=distrisoft_test
# Only when the test server itself uses NODE_ENV=production:
# INIT_TEST_ALLOW_PRODUCTION=yes

# Docker Compose PostgreSQL credentials (used by docker-compose.yml)
POSTGRES_USER=distrisoft
POSTGRES_PASSWORD=distrisoft
POSTGRES_DB=distrisoft
POSTGRES_PORT=5432
