NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://distrisoft:distrisoft@localhost:5432/distrisoft

# Comma-separated origins, or * for all (development only)
CORS_ORIGIN=*

# Random string of at least 32 characters. Do not commit a real value.
JWT_SECRET=replace-with-a-random-string-of-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Password for the development seed users. Never use it in production.
SEED_PASSWORD=replace-with-a-test-password

# Docker Compose PostgreSQL credentials (used by docker-compose.yml)
POSTGRES_USER=distrisoft
POSTGRES_PASSWORD=distrisoft
POSTGRES_DB=distrisoft
POSTGRES_PORT=5432
